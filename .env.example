# Backend Environment Variables
# Copy this to .env and fill in your values

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Database URL (Railway provides this automatically)
# LOCAL: sqlite:///./data/jobforge.db
# RAILWAY: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/jobforge

# CORS Origins (comma-separated)
# LOCAL: http://localhost:5173
# PRODUCTION: https://your-frontend-domain.vercel.app
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# Scraper defaults
SCRAPER_DELAY_SECONDS=2.0
SCRAPER_JITTER_SECONDS=1.0

# Default search keywords
DEFAULT_KEYWORDS=data scientist,machine learning engineer,AI intern,NLP engineer,MLOps,deep learning

# Greenhouse company slugs
GREENHOUSE_COMPANIES=anthropic,huggingface,openai,deepmind,databricks,cohere,scale-ai,wandb,neptune-ai,clarifai,snorkel-ai

# Lever company slugs
LEVER_COMPANIES=openai,mistral,together-ai,modal,replicate,langchain,llamaindex
