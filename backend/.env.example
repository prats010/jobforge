# JobForge Environment Variables
# Copy this file to .env and fill in your values

# Gemini AI API Key (get free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (SQLite, auto-created)
DATABASE_URL=sqlite:///./data/jobforge.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Default search keywords (comma-separated)
DEFAULT_KEYWORDS=data scientist,machine learning engineer,AI intern,NLP engineer,MLOps,deep learning

# Greenhouse company slugs (comma-separated)
GREENHOUSE_COMPANIES=anthropic,huggingface,openai,deepmind,databricks,cohere,scale-ai,wandb,neptune-ai,clarifai,snorkel-ai

# Lever company slugs (comma-separated)
LEVER_COMPANIES=openai,mistral,together-ai,modal,replicate,langchain,llamaindex
